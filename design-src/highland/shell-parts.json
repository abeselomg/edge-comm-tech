{
  "styles": "<style>\r\n    body { background: #eef6f4; color: #1c2430; font-family: \"Atkinson Hyperlegible\", sans-serif; }\r\n    .font-display { letter-spacing: -0.03em; font-weight: 700; }\r\n    .sun-disk {\r\n      position: absolute;\r\n      right: -6rem;\r\n      top: -5rem;\r\n      width: 22rem;\r\n      height: 22rem;\r\n      border-radius: 999px;\r\n      background: radial-gradient(circle at 40% 40%, #fff8 0%, #0888c5 42%, transparent 70%);\r\n      opacity: 0.55;\r\n      pointer-events: none;\r\n    }\r\n    .horizon {\r\n      position: absolute;\r\n      left: 0;\r\n      right: 0;\r\n      bottom: 28%;\r\n      height: 1px;\r\n      background: linear-gradient(90deg, transparent, #0888c5 20%, #0888c5 80%, transparent);\r\n      pointer-events: none;\r\n    }\r\n    .hop-line {\r\n      flex: 1;\r\n      height: 1px;\r\n      margin-top: 0.55rem;\r\n      background-image: repeating-linear-gradient(90deg, #0888c5 0 6px, transparent 6px 12px);\r\n    }\r\n    .ph {\r\n      border-bottom: 1px dashed #0888c5;\r\n    }\r\n    .ph::after {\r\n      content: \"▪\";\r\n      font-size: 0.45em;\r\n      vertical-align: super;\r\n      margin-left: 0.15em;\r\n      color: #c48a5a;\r\n    }\r\n    :focus-visible { outline: 2px solid #0888c5; outline-offset: 3px; }\r\n  </style>",
  "header": "<header class=\"sticky top-0 z-40 border-b border-rule bg-paper/90 text-ink backdrop-blur\">\r\n    <div class=\"mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-4\">\r\n      <a href=\"#\" class=\"leading-none\">\r\n        <span class=\"block font-mono text-[10px] uppercase tracking-[0.35em] text-gold\">Edge</span>\r\n        <span class=\"font-display text-xl tracking-tight\">COMM-TECH</span>\r\n      </a>\r\n      <nav class=\"hidden items-center gap-5 text-sm lg:flex\" aria-label=\"Main\">\r\n        <a href=\"#about\" class=\"text-ink/70 hover:text-gold\">About</a>\r\n        <a href=\"#partners\" class=\"text-ink/70 hover:text-gold\">Partners</a>\r\n        <a href=\"#solutions\" class=\"text-ink/70 hover:text-gold\">Solutions</a>\r\n        <a href=\"#record\" class=\"text-ink/70 hover:text-gold\">Projects</a>\r\n        <a href=\"#academy\" class=\"text-ink/70 hover:text-gold\">Academy</a>\r\n        <a href=\"#career\" class=\"text-ink/70 hover:text-gold\">Career</a>\r\n        <a href=\"#blog\" class=\"text-ink/70 hover:text-gold\">Blog</a>\r\n      </nav>\r\n      <a href=\"#contact\" class=\"hidden rounded-full bg-gold px-4 py-2 text-sm text-white md:inline-block\">Contact us</a>\r\n    </div>\r\n    <nav class=\"flex gap-4 overflow-x-auto border-t border-rule px-6 py-2.5 text-xs lg:hidden\">\r\n      <a href=\"#about\" class=\"whitespace-nowrap text-ink/70\">About</a>\r\n      <a href=\"#partners\" class=\"whitespace-nowrap text-ink/70\">Partners</a>\r\n      <a href=\"#solutions\" class=\"whitespace-nowrap text-ink/70\">Solutions</a>\r\n      <a href=\"#record\" class=\"whitespace-nowrap text-ink/70\">Projects</a>\r\n      <a href=\"#academy\" class=\"whitespace-nowrap text-ink/70\">Academy</a>\r\n      <a href=\"#career\" class=\"whitespace-nowrap text-ink/70\">Career</a>\r\n      <a href=\"#blog\" class=\"whitespace-nowrap text-ink/70\">Blog</a>\r\n      <a href=\"#contact\" class=\"whitespace-nowrap text-gold\">Contact