# Postgres connection string. Local default matches docker-compose.yml.
DATABASE_URI=postgres://edge:edge@127.0.0.1:5434/edge_comm_tech

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Media storage. With S3_BUCKET unset, uploads go to local disk for
# development. Set all five for any S3-compatible bucket -- AWS, Cloudflare
# R2, Backblaze B2 or MinIO -- which is what keeping both hosting options
# open requires.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
