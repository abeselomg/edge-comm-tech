# Postgres connection string. Local default matches docker-compose.yml.
DATABASE_URI=postgres://edge:edge@127.0.0.1:5434/edge_comm_tech

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Media storage. With S3_BUCKET unset, uploads go to local disk for
# development. Set S3_BUCKET, S3_REGION and both keys together to use any
# S3-compatible bucket (AWS, Cloudflare R2, Backblaze B2, MinIO).
# S3_ENDPOINT is for non-AWS services only (R2, B2, MinIO); leave it blank
# for AWS. Cloudflare R2 uses region "auto"; B2 needs its own region name.
# On AWS with an IAM role, leave both keys unset and the SDK's default
# credential chain is used. Setting only one key is an error.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Outgoing mail for form submissions. Unset SMTP_HOST in development and the
# notification is logged and skipped; submissions are always stored regardless,
# and a failed send is recorded on the submission, never lost.
# Placeholders only: real values live in the server's environment, never here.
# SMTP_FROM is required once SMTP_HOST is set. SMTP_USER and SMTP_PASS are set
# together or not at all. Port 465 uses TLS; other ports use STARTTLS if offered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Used only when a form has no recipient of its own.
FORM_NOTIFY_FALLBACK=

# The form submission route (POST /forms/<slug>). Defaults: 5 submissions per
# 10 minutes per client per form, and one trusted proxy (nginx) in front.
# TRUSTED_PROXY_HOPS is how many proxies append to X-Forwarded-For; set it to
# match the deployment or clients can spoof their rate-limit key.
FORM_RATE_MAX=5
FORM_RATE_WINDOW_SEC=600
TRUSTED_PROXY_HOPS=1
